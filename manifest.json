{
  "manifest_version": 3,
  "name": "Aeries Grade Calculator",
  "version": "9.4",
  "description": "Calculate 'What-If' grades, detect hidden assignments, and chat with AI about anything from your Aeries gradebook.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.aeries.net/*",
    "*://*.aeries.com/*",
    "*://*.aeriescloud.net/*",
    "https://htxvtjdkalfnujztetmi.supabase.co/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.aeries.net/*",
        "*://*.aeries.com/*",
        "*://*.aeriescloud.net/*"
      ],
      "js": [
        "content-detector.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}